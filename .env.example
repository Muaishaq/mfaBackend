# Backend env template — copy to .env for development.
# Never commit real .env file to git.
# Production values belong in the Render dashboard, not in git.

# Database (Supabase PostgreSQL)
# PgBouncer (Supabase pooler) requires the query parameters below
DATABASE_URL=postgresql://user:password@host:port/database?pgbouncer=true&prepared_statements=false&connection_limit=1&pool_timeout=0

# JWT Secrets (generate strong random strings)
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
JWT_REFRESH_SECRET=your_refresh_secret_here_minimum_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Paystack (get from Paystack dashboard)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key

# Email SMTP Configuration (optional - emails disabled if not set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
EMAIL_FROM="MFA Platform" <noreply@mfaacademy.com>

# Frontend URL (for email links and payment callbacks)
FRONTEND_URL=https://mfa-frontend-ten.vercel.app
CLIENT_URL=https://mfa-frontend-ten.vercel.app

# Environment
NODE_ENV=production
PORT=5000
